# Dependencies
node_modules/
vendor/

# Build files (keep build/ for WordPress plugin distribution)
# /build/
*.min.js
*.min.css

# WordPress
wp-config.php
wp-content/uploads/
wp-content/cache/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Temporary folders
tmp/
temp/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Package manager lock files (keep package-lock.json but ignore yarn.lock)
yarn.lock

# Compiled binary addons
build/Release

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity
